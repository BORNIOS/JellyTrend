<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Jellyfin.Plugin.JellyTrend</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Nullable>enable</Nullable>
    <AnalysisMode>AllEnabledByDefault</AnalysisMode>
    <CodeAnalysisRuleSet>../jellyfin.ruleset</CodeAnalysisRuleSet>
    <!--
      Set this to your Jellyfin server version.
      Check https://www.nuget.org/packages/Jellyfin.Controller/ for available versions.
    -->
    <JellyfinVersion>12.1.0</JellyfinVersion>
  </PropertyGroup>

  <ItemGroup>
    <!--
      ExcludeAssets="runtime" prevents Jellyfin assemblies from being bundled into
      the plugin .dll — the server provides them at runtime via its own assembly loader.
    -->
    <PackageReference Include="Jellyfin.Controller" Version="$(JellyfinVersion)">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Model" Version="$(JellyfinVersion)">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Data" Version="$(JellyfinVersion)">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="StyleCop.Analyzers" Version="1.2.0-beta.556" PrivateAssets="All" />
    <PackageReference Include="SmartAnalyzers.MultithreadingAnalyzer" Version="1.1.31" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <!-- ASP.NET Core types (ControllerBase, etc.) — part of the shared runtime, not bundled -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Web/ holds what the clients download: the configuration page and the carousel script/styles that the
      server injects into the web client. Resources/ holds the plugin's own assets (the channel artwork),
      the same split the PostgreSQL provider uses.
    -->
    <EmbeddedResource Include="Web\**\*" Exclude="Web\**\*.cs" />
    <!-- logo.png es un recurso del catalogo de Jellyfin (viaja en el ZIP, no lo lee el codigo): no se embebe. -->
    <EmbeddedResource Include="Resources\**\*" Exclude="Resources\logo.png" />
  </ItemGroup>

</Project>
