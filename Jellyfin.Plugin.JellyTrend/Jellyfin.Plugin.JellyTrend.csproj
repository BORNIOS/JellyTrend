<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>Jellyfin.Plugin.JellyTrend</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Nullable>enable</Nullable>
    <AnalysisMode>AllEnabledByDefault</AnalysisMode>
    <CodeAnalysisRuleSet>../jellyfin.ruleset</CodeAnalysisRuleSet>
    <!--
      Set this to your Jellyfin server version.
      Check https://www.nuget.org/packages/Jellyfin.Controller/ for available versions.
    -->
    <JellyfinVersion>10.11.10</JellyfinVersion>
  </PropertyGroup>

  <ItemGroup>
    <!--
      ExcludeAssets="runtime" prevents Jellyfin assemblies from being bundled into
      the plugin .dll — the server provides them at runtime via its own assembly loader.
    -->
    <PackageReference Include="Jellyfin.Controller" Version="$(JellyfinVersion)">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Model" Version="$(JellyfinVersion)">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Data" Version="$(JellyfinVersion)">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!--
      Serilog is the logging library Jellyfin itself uses. The plugin builds its own
      logger with a file sink so it writes to a dedicated per-month log file
      (log/JellyTrend-YYYYMM.log) inside the server's official log directory.
      Versions match the local server runtime (Serilog 4.2.0).
    -->
    <PackageReference Include="Serilog" Version="4.2.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Code analysis packages (build-time only, never shipped with the plugin) -->
    <PackageReference Include="SerilogAnalyzer" Version="0.15.0" PrivateAssets="All" />
    <PackageReference Include="StyleCop.Analyzers" Version="1.2.0-beta.556" PrivateAssets="All" />
    <PackageReference Include="SmartAnalyzers.MultithreadingAnalyzer" Version="1.1.31" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <!-- ASP.NET Core types (ControllerBase, etc.) — part of the shared runtime, not bundled -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!--
      All files under Web/ (config page assets, carousel script/styles, channel poster)
      are embedded into the assembly as resources.
      configPage.html lives in Configuration/ following the official plugin template.
    -->
    <None Remove="Configuration\configPage.html" />
    <EmbeddedResource Include="Configuration\configPage.html" />
    <EmbeddedResource Include="Web\**\*" Exclude="Web\**\*.cs" />
  </ItemGroup>

</Project>
