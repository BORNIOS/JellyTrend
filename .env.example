# ─────────────────────────────────────────────────────────────
# JellyTrend — configuración local de desarrollo
# Copia este archivo a `.env` y ajusta las rutas a TU instalación.
# `.env` está en .gitignore (nunca se sube al repo).
# El flujo build/copy/run lo orquestan las tareas de VS Code (tasks.json),
# que cargan este `.env` automáticamente — no hace falta ningún script.
# ─────────────────────────────────────────────────────────────

# Nombre del proyecto/plugin (no lo cambies a menos que renombres la solución).
PLUGIN_NAME=Jellyfin.Plugin.JellyTrend

# Carpeta donde vive jellyfin.exe / jellyfin.dll (raíz de la instalación portable).
JELLYFIN_SERVER_DIR=D:\jellyfin-portable

# Carpeta de jellyfin-web (donde está index.html).
JELLYFIN_WEB_DIR=D:\jellyfin-portable\jellyfin-web

# Carpeta de datos de Jellyfin (donde están config/, plugins/, metadata/…).
# El DLL del plugin se copia a: $JELLYFIN_DATA_DIR/plugins/$PLUGIN_NAME/
# En Windows portable suele ser %LOCALAPPDATA%\jellyfin
JELLYFIN_DATA_DIR=C:\Users\<tu-usuario>\AppData\Local\jellyfin
