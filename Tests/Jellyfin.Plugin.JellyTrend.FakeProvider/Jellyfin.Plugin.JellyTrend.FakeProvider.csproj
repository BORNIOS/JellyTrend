<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Plugin de mentira para las pruebas: replica el contrato de JellyTrend igual que hace el plugin de
    PostgreSQL (su propia copia del tipo, en su propio ensamblado). Sirve para comprobar que JellyTrend lo
    encuentra y lo usa aunque no comparta tipos con el.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>Jellyfin.Plugin.JellyTrend.Api</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.0" />
  </ItemGroup>

</Project>
